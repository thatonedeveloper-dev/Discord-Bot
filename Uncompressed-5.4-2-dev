rating_lock = asyncio.Lock()
_rating_history: Dict[int, dict] = {}
_last_rating_cleanup = time.time()

def _cleanup_rating_history():
    global _last_rating_cleanup
    now = time.time()
    if now - _last_rating_cleanup < 600: return
    _last_rating_cleanup = now
    expired = [uid for uid, v in _rating_history.items() if now - v.get("time",0) > 1800]
    for uid in expired: del _rating_history[uid]

def _user_to_seed(user):
    try: d = int(user.discriminator)
    except (ValueError, TypeError): d = 0
    nh = hashlib.sha256(user.name.encode()).hexdigest()
    ah = hashlib.sha256(str(user.avatar).encode()).hexdigest() if user.avatar else "0"
    combined = f"{user.id}{user.created_at.timestamp()}{nh}{d}{ah}"
    return (sum(ord(c) for c in combined) % 10000) / 10000.0

def _find_keywords(name):
    lower = name.lower()
    fp = {w for w in POSITIVE_WORDS if re.search(r'(?<![a-zA-Z])'+re.escape(w)+r'(?![a-zA-Z])', lower)}
    fn = {w for w in NEGATIVE_WORDS if re.search(r'(?<![a-zA-Z])'+re.escape(w)+r'(?![a-zA-Z])', lower)}
    fn -= fp
    return list(fp), list(fn)

def _generate_explanation(fp, fn):
    ps = ", ".join(f"**{w}**" for w in fp)
    ns = ", ".join(f"**{w}**" for w in fn)
    if fp and not fn: return random.choice(POSITIVE_ONLY_TEMPLATES).format(pos_list=ps, neg_list="")
    if fn and not fp: return random.choice(NEGATIVE_ONLY_TEMPLATES).format(pos_list="", neg_list=ns)
    if fp and fn: return random.choice(MIXED_TEMPLATES).format(pos_list=ps, neg_list=ns)
    return random.choice(NO_KEYWORD_TEMPLATES).format(pos_list="", neg_list="")

def compute_rating_with_explanation(user, mn=1, mx=10):
    s = _user_to_seed(user)
    base = mn + int(s*(mx-mn))
    fp, fn = _find_keywords(user.name.lower())
    adj = sum(random.uniform(0.1,0.4) for _ in fp) - sum(random.uniform(0.1,0.4) for _ in fn)
    rating = int(max(mn, min(round(base+adj), mx)))
    return rating, _generate_explanation(fp, fn)

async def get_troll_response(rid, tid, mention):
    _cleanup_rating_history()
    now = time.time()
    async with rating_lock:
        prev = _rating_history.get(rid)
        if not prev: return None
        td = now - prev["time"]
        same = (tid == prev["target_id"])
        if same and td < 30:
            if random.random() < 0.4: return None
            r = prev.get("rating")
            t = random.choice(REPEAT_HIGH_TEMPLATES if (r or 0) >= 7 else REPEAT_LOW_TEMPLATES)
            _rating_history[rid]["time"] = now
            return t.format(rating=r if r is not None else "?")
        if not same and td < 60:
            pr = prev.get("rating")
            pm = prev.get("mention", f"<@{prev['target_id']}>")
            t = random.choice(MOVED_ON_HIGH_TEMPLATES if (pr or 0) >= 7 else MOVED_ON_LOW_TEMPLATES)
            _rating_history[rid] = {"target_id": tid, "rating": None, "time": now, "mention": mention}
            return t.format(prev_rating=pr if pr is not None else "?", prev_mention=pm)
    return None

async def handle_rating(interaction, target_id, mn, mx, message):
    rid = interaction.user.id
    try:
        target_user = await client.fetch_user(target_id)
        mention = target_user.mention
    except discord.NotFound:
        try:
            await interaction.response.send_message(f"msg: {message}")
            await interaction.followup.send("User not found, sorry.")
        except Exception: pass
        return
    except discord.HTTPException as e:
        logger.error("HTTP error fetching user: %s", e)
        await send_error_dm(f"HTTP fetch error {target_id}: {e}", interaction, "warning")
        try:
            await interaction.response.send_message(f"msg: {message}")
            await interaction.followup.send("Discord hiccup. Try again.")
        except Exception: pass
        return
    except Exception as e:
        logger.error("Unexpected fetch error: %s", e)
        await send_error_dm(f"Fetch error: {e}", interaction, "error")
        try:
            await interaction.response.send_message(f"msg: {message}")
            await interaction.followup.send("Something went wrong.")
        except Exception: pass
        return

    troll = await get_troll_response(rid, target_id, mention)
    if troll:
        try:
            await interaction.response.send_message(f"msg: {message}")
            await interaction.followup.send(troll)
        except Exception: pass
        return

    rating, expl = compute_rating_with_explanation(target_user, mn, mx)
    txt = _add_disclaimer(f"I rate {mention} **{rating}/{mx}** 🌟\n{expl}")
    try:
        await interaction.response.send_message(f"msg: {message}")
        await interaction.followup.send(txt)
    except Exception: pass

    async with rating_lock:
        _rating_history[rid] = {"target_id": target_id, "rating": rating, "time": time.time(), "mention": mention}

