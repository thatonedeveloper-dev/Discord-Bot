# ═══════════════════════════════════════════════════════════════════════
# CONTENT FILTER ENGINE (TF‑IDF + fallback)
# ═══════════════════════════════════════════════════════════════════════
_filter_patterns = []
_filter_tags = []
_filter_vectorizer = None
_filter_vectors = None
_filter_loaded = False

def load_filter():
    global _filter_patterns, _filter_tags, _filter_vectorizer, _filter_vectors, _filter_loaded
    if not os.path.exists(FILTER_FILE):
        os.makedirs(BASE_DIR, exist_ok=True)
        starter = {"intents":[
            {"tag":"fuck","patterns":["fuck","f*ck","f**k","f***","fck","fuuck","fuuuck","fuk","fukk","f4ck","f0ck","f u c k","f.ck","f*ck","eff you see kay","fack","phuck","phuk","f***ing","fk","fkn","fckn","fkin","f***in","f-ing","fucking","f u c k i n g"]},
            {"tag":"shit","patterns":["shit","sh*t","sh1t","sh!t","sht","shitt","shiiiit","shite","shyte","s h i t","sh.it","$hit","$h*t","5hit","sh1t","s,h,i,t","s-h-i-t","s.h.i.t"]},
            {"tag":"ass","patterns":["ass","a$$","a**","azz","a s s","arse","@ss","a55","4ss"]},
            {"tag":"bitch","patterns":["bitch","b*tch","b!tch","b1tch","biatch","beyotch","b i t c h","b17ch","b1tch","beotch"]},
            {"tag":"nigger","patterns":["nigger","n*gger","n!gger","n1gger","nigg3r","n1gg3r","nigga","n*gga","n!gga","n1gga","nigg@","n i g g e r","n i g g a","nibba","n1bb4","nibb@"]},
            {"tag":"retard","patterns":["retard","r*tard","r3tard","ret4rd","r3t4rd","ret@rd","r e t a r d","retrd","rtard","ritard"]}
        ]}
        with open(FILTER_FILE,"w",encoding="utf-8") as f: json.dump(starter,f,indent=2,ensure_ascii=False)
    try:
        with open(FILTER_FILE,"r",encoding="utf-8") as f: data = json.load(f)
    except Exception:
        logger.warning("filter.json corrupted – using exact‑word fallback")
        _filter_loaded = True; return
    _filter_patterns.clear(); _filter_tags.clear()
    for intent in data.get("intents",[]):
        for p in intent.get("patterns",[]):
            _filter_patterns.append(p.lower().strip())
            _filter_tags.append(intent["tag"])
    if not _filter_patterns:
        logger.warning("Empty filter patterns – using exact‑word fallback")
        _filter_loaded = True; return
    try:
        _filter_vectorizer = TfidfVectorizer(analyzer='char_wb', ngram_range=(3,6))
        _filter_vectors = _filter_vectorizer.fit_transform(_filter_patterns)
        _filter_loaded = True
        logger.info("Filter model trained with %d patterns", len(_filter_patterns))
    except Exception as e:
        logger.error("Filter training failed: %s", e)
        _filter_loaded = True

_BLOCKED_PATTERNS_FALLBACK = [
    re.compile(r'\b' + re.escape(word) + r'\b', re.IGNORECASE)
    for word in BLOCKED_WORDS_FALLBACK
]

_FILTER_WHITELIST = {
    "assistance", "class", "pass", "grass", "mass", "assist",
    "trigger", "triggers", "trig", "try", "trick", "track",
    "shift", "sh*t", "shin", "shy", "sheet", "shoot"
}

_filter_lock = asyncio.Lock()

def _filter_text(text):
    if not _filter_loaded: load_filter()
    
    if _filter_vectorizer is None or _filter_vectors is None or not _filter_patterns:
        for pat in _BLOCKED_PATTERNS_FALLBACK:
            text = pat.sub("[Filtered]", text)
        return text

    lines = text.splitlines(keepends=True)
    filtered_lines = []
    max_pattern_len = max(len(p) for p in _filter_patterns)

    for line in lines:
        line_text = line.rstrip('\n\r') if line.endswith(('\n','\r')) else line
        words = line_text.split()
        filtered_words = []
        
        for word in words:
            cleaned = re.sub(r'[^\w]|_', '', word.lower().strip())
            if len(cleaned) <= 1 or cleaned in _FILTER_WHITELIST:
                filtered_words.append(word)
                continue
            try:
                vec = _filter_vectorizer.transform([cleaned])
                sims = cosine_similarity(vec, _filter_vectors)
                if sims.size > 0 and sims.shape[1] > 0:
                    confidence = float(sims[0][sims.argmax()])
                    if confidence >= FILTER_CONFIDENCE_THRESHOLD:
                        if len(cleaned) <= max_pattern_len:
                            filtered_words.append("[Filtered]")
                            continue
            except Exception: pass
            filtered_words.append(word)
        
        rebuilt = " ".join(filtered_words)
        if line.endswith('\n'):
            rebuilt += '\n'
        elif line.endswith('\r'):
            rebuilt += '\r'
        filtered_lines.append(rebuilt)

    return "".join(filtered_lines)

_filter_events = deque(maxlen=200)
_auto_lock_enabled = True
_chat_enabled = True
_rating_enabled = True
_disable_reason = "maintenance"
_panic_locked = False
_panic_prev_reason = ""
_chat_log = deque(maxlen=5000)

async def _apply_auto_lockdown(user_id):
    global _chat_enabled, _disable_reason
    if not _auto_lock_enabled: return
    now = time.time()
    async with _filter_lock:
        while _filter_events and _filter_events[0][0] < now - AUTO_LOCK_WINDOW:
            _filter_events.popleft()
        users = {uid for _, uid in _filter_events}
        if len(users) >= AUTO_LOCK_THRESHOLD:
            _chat_enabled = False
            _disable_reason = "Auto‑lockdown: multiple filtered messages"
            logger.warning("Auto‑lockdown: %d users in %ds", len(users), AUTO_LOCK_WINDOW)
            await send_error_dm(f"Chat disabled by auto‑lockdown ({len(users)} users)", level="warning")

# ═══════════════════════════════════════════════════════════════════════
# MATH ENGINE (safe eval, word‑to‑number, operators) – hardened
# ═══════════════════════════════════════════════════════════════════════
_SAFE_MATH_NAMES = {
    "abs":abs,"round":round,"min":min,"max":max,
    "sqrt":math.sqrt,"sin":math.sin,"cos":math.cos,
    "tan":math.tan,"asin":math.asin,"acos":math.acos,
    "atan":math.atan,"atan2":math.atan2,"log":math.log,
    "log10":math.log10,"log2":math.log2,"exp":math.exp,
    "pow":math.pow,"pi":math.pi,"e":math.e,
    "tau":math.tau,"inf":math.inf,"nan":math.nan,
    "ceil":math.ceil,"floor":math.floor,"degrees":math.degrees,
    "radians":math.radians,"gcd":math.gcd,"lcm":math.lcm,
}

_EVAL_BLOCKLIST_PATTERNS = [re.compile(p, re.IGNORECASE) for p in [
    r'__', r'\.\s*__', r'\(\)', r'"', r"'", r'\bclass\b', r'\bbase\b',
    r'\bsubclass\b', r'\bmro\b', r'\bimport\b', r'\bexec\b', r'\bopen\b',
    r'\bfile\b', r'\bglobals\b', r'\blocals\b', r'\bgetattr\b', r'\bsetattr\b',
    r'\bdelattr\b', r'\bbuiltins\b', r'\bfrozen\b', r'\bos\.', r'\bsystem\b',
    r'\bpopen\b', r'\bf_back\b', r'\bf_code\b', r'\btb_frame\b', r'\btraceback\b',
    r'\baudit\b', r'\bhook\b', r'\bcodec\b', r'\bencode\b', r'\bdecode\b',
    r'\brunpy\b', r'\brunp\b', r'\brun\s*\_', r'\bimportlib\b',
]]

_VALID_MATH_RE = re.compile(r'^[a-zA-Z0-9\s+*/^%!().,\-]+$')

_WORD_NUMBERS = {
    "zero":0,"one":1,"two":2,"three":3,"four":4,"five":5,"six":6,"seven":7,"eight":8,"nine":9,
    "ten":10,"eleven":11,"twelve":12,"thirteen":13,"fourteen":14,"fifteen":15,"sixteen":16,"seventeen":17,
    "eighteen":18,"nineteen":19,"twenty":20,"thirty":30,"forty":40,"fifty":50,"sixty":60,"seventy":70,
    "eighty":80,"ninety":90,"hundred":100,"thousand":1000,"million":1000000,"billion":1000000000,
}

_WORD_OPERATORS = {
    "plus":r'\bplus\b', "added to":r'\badded\s+to\b', "add":r'\badd\b',
    "minus":r'\bminus\b', "subtract":r'\bsubtract\b', "subtracted from":r'\bsubtracted\s+from\b',
    "less":r'\bless\b', "take away":r'\btake\s+away\b',
    "times":r'\btimes\b', "multiplied by":r'\bmultiplied\s+by\b', "multiply":r'\bmultiply\b',
    "divided by":r'\bdivided\s+by\b', "divide":r'\bdivide\b', "over":r'\bover\b',
    "to the power of":r'\bto\s+the\s+power\s+of\b', "raised to":r'\braised\s+to\b',
    "modulo":r'\bmodulo\b', "mod":r'\bmod\b', "remainder of":r'\brest\s+of\b',
    "squared":r'\bsquared\b', "cubed":r'\bcubed\b',
    "square root of":r'\bsquare\s+root\s+of\b', "the square root of":r'\bthe\s+square\s+root\s+of\b',
    "cube root of":r'\bcube\s+root\s+of\b',
}

_OP_SYMBOLS = {
    "plus":"+","added to":"+","add":"+",
    "minus":"-","subtract":"-","subtracted from":"-","less":"-","take away":"-",
    "times":"*","multiplied by":"*","multiply":"*",
    "divided by":"/","divide":"/","over":"/",
    "to the power of":"**","raised to":"**",
    "modulo":"%","mod":"%","remainder of":"%",
    "squared":"**2","cubed":"**3",
    "square root of":"sqrt(","the square root of":"sqrt(",
    "cube root of":"cbrt(",
}

_WORD_CONSTANTS = {"pi":"pi","e":"e","tau":"tau","infinity":"inf","inf":"inf"}

def _words_to_number(text):
    text = text.lower().strip()
    text = re.sub(r'\ba\b', '', text).replace(" and ", " ")
    text = re.sub(r'[!?.,;:]+$', '', text)
    words = text.split()
    if not words: return text
    total = current = 0
    for word in words:
        if word in _WORD_NUMBERS:
            val = _WORD_NUMBERS[word]
            if val >= 1000:
                if current == 0: current = 1
                current *= val; total += current; current = 0
            elif val >= 100:
                if current == 0: current = 1
                current *= val
            else: current += val
        else: return text
    total += current
    return str(total) if total != 0 else text

def _sanitize_for_eval(expr):
    for pat in _EVAL_BLOCKLIST_PATTERNS:
        if pat.search(expr): return None
    if not _VALID_MATH_RE.match(expr): return None
    if len(expr) > 200: return None
    return expr

_NUM_WORD_RE = re.compile(r'(?:(?:'+'|'.join(re.escape(w) for w in _WORD_NUMBERS)+r')\s*)+')

def _replace_word_operators(expression):
    try:
        expr = expression.lower().strip()
        for word, const in sorted(_WORD_CONSTANTS.items(), key=lambda x:-len(x[0])):
            expr = expr.replace(word, const)
        sorted_ops = sorted(_WORD_OPERATORS.items(), key=lambda x:-len(x[0]))
        for phrase, pattern in sorted_ops:
            symbol = _OP_SYMBOLS.get(phrase, "")
            if not symbol: continue
            if symbol in ("**2","**3"):
                expr = re.sub(r'(\d+|\))\s*' + pattern, r'\1' + symbol, expr)
            elif symbol in ("sqrt(","cbrt("):
                expr = re.sub(pattern + r'\s*(\d+(?:\.\d+)?|\([^)]+\))',
                              lambda m, s=symbol: s + m.group(1) + ")", expr)
            else:
                expr = re.sub(pattern, f" {symbol} ", expr)
        expr = _NUM_WORD_RE.sub(lambda m: _words_to_number(m.group(0)), expr)
        expr = re.sub(r'\s+',' ',expr).strip()
        expr = re.sub(r'^(what is|whats|what\'s|calculate|solve|compute|evaluate|find|tell me|how much is)\s*','',expr,flags=re.IGNORECASE)
        expr = expr.rstrip('?=').strip()
        return expr
    except Exception: return expression

def _is_math_expression(text):
    if not text: return False
    stripped = text.strip().lower()
    has_sym = bool(re.search(r'[+\-*/^%!()]|//|\*\*', stripped))
    has_word = any(re.search(p, stripped) for p in _WORD_OPERATORS.values())
    has_digit = bool(re.search(r'[0-9]', stripped))
    has_word_num = any(w in stripped.split() for w in _WORD_NUMBERS)
    has_const = any(c in stripped.split() for c in _WORD_CONSTANTS)
    has_number = has_digit or has_word_num or has_const
    is_simple = bool(re.match(r'^[0-9]*\.?[0-9]+$', stripped))
    if is_simple and not (has_sym or has_word): return False
    return has_number and (has_sym or has_word)

def solve_single(expression):
    expr = _replace_word_operators(expression).strip().replace("^","**")
    expr = re.sub(r'cbrt\(([^)]+)\)', r'(\1)**(1/3)', expr)
    expr = _sanitize_for_eval(expr)
    if expr is None: return None
    try:
        safe_dict = {"__builtins__":{}}
        safe_dict.update(_SAFE_MATH_NAMES)
        result = eval(expr, safe_dict)
        if isinstance(result,(int,float)):
            if isinstance(result,float) and result == int(result): result = int(result)
            if isinstance(result,float): result = round(result,10)
            return str(result)
        return str(result)
    except (SyntaxError,TypeError,ValueError,ZeroDivisionError,OverflowError,MemoryError,RecursionError): return None
    except Exception: return None

def _split_equations(text):
    parts, current, depth = [], [], 0
    for char in text:
        if char in '([{': depth += 1
        elif char in ')]}': depth = max(0,depth-1)
        elif char in ',;' and depth == 0:
            parts.append(''.join(current).strip()); current = []; continue
        current.append(char)
    if current: parts.append(''.join(current).strip())
    return [p for p in parts if p]

def solve_multi(message):
    parts = _split_equations(message)
    if not parts: return None
    results = []
    for p in parts:
        if not _is_math_expression(p): return None
        ans = solve_single(p)
        if ans is None: return None
        results.append((p,ans))
    return results

_SIMPLE_CONSTANTS = {'pi','e','tau','inf','nan'}

def _is_complex(expr):
    cleaned = re.sub(r'[0-9+\-*/^%!()\[\]\s.]', '', expr.lower().strip())
    return bool(set(re.findall(r'[a-zA-Z_]+', cleaned)) - _SIMPLE_CONSTANTS)

