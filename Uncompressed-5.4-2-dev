    embed = discord.Embed(
        title="🛠️ Server Setup Guide",
        description="So you invited me. Now what? Follow this, and maybe I won't disappoint you.",
        color=0x57F287
    )
    embed.add_field(
        name="1️⃣ Invite the bot",
        value=f"Use [this invite link]({SETUP_INVITE_LINK}) and select your server. If you mess this up, I can't help you.",
        inline=False
    )
    embed.add_field(
        name="2️⃣ Required Permissions",
        value="I need these permissions to not be useless:\n"
              "• Read Messages & View Channels\n"
              "• Send Messages\n"
              "• Manage Messages (for /purge, /say, /announce)\n"
              "• Manage Channels (for /lock, /unlock, /slowmode)\n"
              "• Manage Nicknames (for /nickname)\n"
              "• Manage Roles (for /role)\n"
              "• Moderate Members (for /warn)\n"
