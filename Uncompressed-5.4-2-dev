]
_MIXED_MULTI_ITEM_FORMATS = [
    "{expr} = {ans}","{expr} → {ans}","{expr} gives {ans}","the value of {expr} is {ans}",
    "{expr} simplifies to {ans}","{expr} equals {ans}","for {expr} we get {ans}",
    "{expr} yields {ans}","{expr} -> {ans}","solving {expr} leads to {ans}",
]
_MIXED_MULTI_JOINERS = [", ","; "," and "," then "," also "," plus ",
                        " along with "," together with "," further, "," moreover, "]

def _format_multiple_mixed(eqs):
    h = random.choice(_MIXED_MULTI_HEADERS)
    items = [random.choice(_MIXED_MULTI_ITEM_FORMATS).format(expr=e,ans=a) for e,a in eqs]
    return f"{h} {random.choice(_MIXED_MULTI_JOINERS).join(items)}"

def generate_math_response(equations):
    sc = sum(not _is_complex(e) for e,_ in equations)
    cc = len(equations) - sc
    if len(equations) == 1:
        t = random.choice(_COMPLEX_SINGLE_TEMPLATES if cc else _SIMPLE_SINGLE_TEMPLATES)
        reply = t.format(expr=equations[0][0], ans=equations[0][1])
    elif cc == 0: reply = _format_multiple_simple(equations)
    elif sc == 0: reply = _format_multiple_complex(equations)
    else: reply = _format_multiple_mixed(equations)
    if len(reply) > 1950:
        reply = reply[:1950]
        ls = reply.rfind(' ')
        if ls > 1900:
            reply = reply[:ls] + "..."
        else:
            reply = reply[:1947] + "..."
    return reply

# ═══════════════════════════════════════════════════════════════════════
# PATTERN‑MATCHING CHATBOT
# ═══════════════════════════════════════════════════════════════════════
def clean_text(text):
    return re.sub(r"[^a-z0-9\s\|]", "", text.lower()).strip()

class Chatbot:
    def __init__(self):
        self.data={}; self.patterns=[]; self.tags=[]; self.responses={}
        self.vectorizer=None; self.vectors=None
        self.context_data={}; self.context_patterns=[]; self.context_tags=[]; self.context_responses={}
        self.context_vectorizer=None; self.context_vectors=None
        self.load_context(); self.load_intents(); self.train_context(); self.train()

    def load_context(self):
        if not os.path.exists(CONTEXT_FILE):
            os.makedirs(BASE_DIR,exist_ok=True)
            with open(CONTEXT_FILE,"w",encoding="utf-8") as f: json.dump({"intents":[]},f,indent=2)
        try:
            with open(CONTEXT_FILE,"r",encoding="utf-8") as f: self.context_data = json.load(f)
        except Exception: self.context_data = {"intents":[]}
        self.context_patterns.clear(); self.context_tags.clear(); self.context_responses.clear()
        for intent in self.context_data.get("intents",[]):
            self.context_responses[intent["tag"]] = intent.get("responses",[])
            for p in intent.get("patterns",[]):
                self.context_patterns.append(clean_text(p)); self.context_tags.append(intent["tag"])

    def train_context(self):
        if not self.context_patterns: self.context_vectorizer=self.context_vectors=None; return
        try:
            self.context_vectorizer = TfidfVectorizer()
            self.context_vectors = self.context_vectorizer.fit_transform(self.context_patterns)
        except Exception: self.context_vectorizer=self.context_vectors=None

    def predict_context(self, combined):
        if self.context_vectorizer is None or self.context_vectors is None: return None,0.0
        try:
            vec = self.context_vectorizer.transform([clean_text(combined)])
            sims = cosine_similarity(vec,self.context_vectors)
            if sims.size==0 or sims.shape[0]==0 or sims.shape[1]==0: return None,0.0
            idx = sims.argmax()
            return self.context_tags[idx], float(sims[0][idx])
        except Exception: return None,0.0

    def load_intents(self):
        if not os.path.exists(INTENTS_FILE):
            os.makedirs(BASE_DIR,exist_ok=True)
            default_intents = {
                "intents": [
                    {"tag": "greeting", "patterns": ["Hello","Hi","Hey","Good morning"], "responses": ["Hello!","Hi there!"]},
                    {"tag": "badapple_trigger", "patterns": ["Rule 86: Bad Apple exists on everything.",
                                                              "Bad Apple rule 86",
                                                              "Rule 86 bad apple",
                                                              "Bad apple exists on everything",
                                                              "If it exists you can play bad apple on it"],
                     "responses": ["badapple"]},
                    {"tag": "bot_insult", "patterns": ["You are just a bot",
                                                        "You're just a bot",
                                                        "You are only a program",
                                                        "You're just a machine",
                                                        "Just a bot",
                                                        "You're not real",
                                                        "Stupid bot",
                                                        "Dumb machine",
                                                        "You are just an AI"],
                     "responses": ["secret"]}
                ]
            }
            with open(INTENTS_FILE,"w",encoding="utf-8") as f: json.dump(default_intents,f,indent=2)
        try:
            with open(INTENTS_FILE,"r",encoding="utf-8") as f: self.data = json.load(f)
        except Exception: self.data = {"intents":[]}
        self.patterns.clear(); self.tags.clear(); self.responses.clear()
        for intent in self.data.get("intents",[]):
            self.responses[intent["tag"]] = intent.get("responses",[])
            for p in intent.get("patterns",[]):
                self.patterns.append(clean_text(p)); self.tags.append(intent["tag"])

    def train(self):
        if not self.patterns: self.vectorizer=self.vectors=None; return
        try:
            self.vectorizer = TfidfVectorizer()
            self.vectors = self.vectorizer.fit_transform(self.patterns)
        except Exception: self.vectorizer=self.vectors=None

    def predict(self, message):
        if self.vectorizer is None or self.vectors is None: return None,0.0
        msg = clean_text(message)
        if not msg: return None,0.0
        try:
            vec = self.vectorizer.transform([msg])
            sims = cosine_similarity(vec,self.vectors)
            if sims.size==0 or sims.shape[0]==0 or sims.shape[1]==0: return None,0.0
            idx = sims.argmax()
            return self.tags[idx], float(sims[0][idx])
        except Exception: return None,0.0

    def reply(self, message, last_user_input=None):
        if last_user_input:
            ctx_tag, ctx_conf = self.predict_context(f"{last_user_input} || {message}")
            if ctx_tag and ctx_conf >= CONFIDENCE_THRESHOLD:
                resp = self.context_responses.get(ctx_tag,[])
                if resp: return random.choice(resp), f"context:{ctx_tag}", ctx_conf
        tag, conf = self.predict(message)
        if tag and conf >= CONFIDENCE_THRESHOLD:
            return random.choice(self.responses[tag]), tag, conf
        return None, None, conf

    def learn(self, user_input, correct_response):
        try:
            for intent in self.data.get("intents",[]):
                if correct_response in intent.get("responses",[]):
                    intent.setdefault("patterns",[]).append(user_input); tag = intent["tag"]; break
            else:
                tag = f"user_intent_{len(self.data.get('intents',[]))}"
                self.data.setdefault("intents",[]).append({"tag":tag,"patterns":[user_input],"responses":[correct_response]})
            with open(INTENTS_FILE,"w",encoding="utf-8") as f: json.dump(self.data,f,indent=2,ensure_ascii=False)
            self.load_intents(); self.train()
            return tag
        except Exception: return None

    def learn_context(self, prev_user, current_user, response):
        try:
            combined = f"{prev_user} || {current_user}"
            for intent in self.context_data.get("intents",[]):
                if response in intent.get("responses",[]):
                    intent.setdefault("patterns",[]).append(combined); tag = intent["tag"]; break
            else:
                tag = f"context_intent_{len(self.context_data.get('intents',[]))}"
                self.context_data.setdefault("intents",[]).append({"tag":tag,"patterns":[combined],"responses":[response]})
            with open(CONTEXT_FILE,"w",encoding="utf-8") as f: json.dump(self.context_data,f,indent=2,ensure_ascii=False)
            self.load_context(); self.train_context()
            return tag
        except Exception: return None

