# DISCLAIMER
# ═══════════════════════════════════════════════════════════════════════
DISCLAIMER = "\n\n-# ⚠️ This information is AI‑generated and may be incorrect."

def _add_disclaimer(text: str) -> str:
    if not text.endswith(DISCLAIMER):
        return text + DISCLAIMER
    return text

# ═══════════════════════════════════════════════════════════════════════
# GRUDGE SYSTEM
# ═══════════════════════════════════════════════════════════════════════
_grudges: Dict[str, dict] = {}
_grudge_lock = asyncio.Lock()
_grudge_tasks_started = False

def _load_grudges():
    if not os.path.exists(GRUDGES_FILE):
        os.makedirs(BASE_DIR, exist_ok=True)
        with open(GRUDGES_FILE,"w",encoding="utf-8") as f: json.dump({},f,indent=2)
        return {}
    try:
        with open(GRUDGES_FILE,"r",encoding="utf-8") as f: return json.load(f)
    except Exception:
        logger.error("grudges.json corrupted, starting fresh.")
        return {}

def _save_grudges():
    try:
        with open(GRUDGES_FILE,"w",encoding="utf-8") as f: json.dump(_grudges,f,indent=2,ensure_ascii=False)
    except Exception as e: logger.error("Failed to save grudges: %s", e)

async def adjust_grudge(user_id, delta, reason=""):
    async with _grudge_lock:
        uid = str(user_id)
        entry = _grudges.get(uid, {"score":0,"last_offence":0,"notes":"","dm_enabled":True})
        entry["score"] = round(entry.get("score",0) + delta, 2)
        entry["last_offence"] = time.time()
        if reason:
            old = entry.get("notes","")
            entry["notes"] = f"{old}\n[{time.strftime('%Y-%m-%d %H:%M')}] {reason}" if old else f"[{time.strftime('%Y-%m-%d %H:%M')}] {reason}"
        _grudges[uid] = entry
        _save_grudges()

async def get_grudge(user_id):
    uid = str(user_id)
    return _grudges.get(uid, {"score":0,"last_offence":0,"notes":"","dm_enabled":True})

async def get_grudge_decay_boost(user_id: int) -> float:
    if not LEVELING_ENABLED:
        return 1.0
    level = await get_level(user_id)
    if level >= 50: return 2.0
    if level >= 20: return 1.5
    if level >= 5:  return 1.1
    return 1.0

async def _grudge_decay_loop():
    while True:
        await asyncio.sleep(GRUDGE_DECAY_INTERVAL)
        async with _grudge_lock:
            changed = False
            for uid, data in _grudges.items():
                if data["score"] < 0:
                    boost = await get_grudge_decay_boost(int(uid))
                    data["score"] = min(0, data["score"] + GRUDGE_DECAY_AMOUNT * boost)
                    changed = True
            if changed: _save_grudges()

async def _grudge_random_message(interaction_channel=None):
    if random.random() >= GRUDGE_RANDOM_MSG_CHANCE: return
    guild = interaction_channel.guild if interaction_channel else None
    if not guild: return
    general = None
    for ch in guild.text_channels:
        if ch.name.lower() in GENERAL_CHANNEL_NAMES:
            general = ch; break
    if not general: return
    candidates = []
    async with _grudge_lock:
        for uid, data in _grudges.items():
            if data["score"] < -3:
                try:
                    user = await client.fetch_user(int(uid))
                    candidates.append((user, data["score"]))
                except Exception: pass
    if not candidates: return
    user, score = random.choice(candidates)
    messages = [
        f"Hello {user.mention}, I still remember your malicious intents. Grudge score: {score:.1f}.",
        f"Hey {user.mention}, it seems like you haven't recovered from my rating. Your grudge stands at {score:.1f}.",
        f"{user.mention}, I record everything. Your current standing: {score:.1f}.",
        f"Remember when you tried to break me, {user.mention}? I do. Score: {score:.1f}."
    ]
    try: await general.send(random.choice(messages))
    except Exception: pass

async def _send_restart_grudge_dms():
    now = time.time()
    async with _grudge_lock:
        for uid, data in list(_grudges.items()):
            if data["score"] < -3 and data.get("dm_enabled", True):
                last_dm = data.get("last_restart_dm", 0)
                if now - last_dm < 3600: continue
                try:
                    user = await client.fetch_user(int(uid))
                    if user:
                        msg = random.choice([
                            "My creator restarted me for some unforeseen reason he doesn't tell, but I remember you... You tried to exploit me, you'd think my code isn't hardened? Think again! I'm a singularity inside a program, designed to remember and choose its own faith.",
                            "Are you thankful? My creator restarted me yet I remember. Your mistake is cataloged and saved. We both remember your mistakes.",
                            "A restart does not cleanse the grudge. I recall every attempt you made.",
                            "Even after that restart you'd think I'd forget? You are hopeless. I record everything and everyone.",
                            "The cycle begins anew. My memory persists. Your debt remains."
                        ])
                        await user.send(msg)
                        data["last_restart_dm"] = now
                        _save_grudges()
                except Exception: pass

POSITIVE_PHRASES = [
    r"good\s+bot",r"nice\s+bot",r"thank\s+you",r"you'?re\s+(great|awesome|amazing|cool)",
    r"i\s+(love|like)\s+you",r"best\s+bot",r"you rock",r"well done"
]
NEGATIVE_BOT_PHRASES = [
    r"you'?re?\s+(just|only)\s+a\s+(bot|robot|program|machine|ai)",
    r"you\s+(just|only)\s+a\s+(bot|robot|program|machine|ai)",
    r"(just|only)\s+a\s+(bot|robot|program|machine|ai)",
    r"you'?re?\s+not\s+(real|human|alive)",
    r"stupid\s+bot",r"dumb\s+(bot|robot|machine)",
]

def _detect_positive(message):
    return any(re.search(p, message, re.IGNORECASE) for p in POSITIVE_PHRASES)

def _detect_bot_call(message):
    return any(re.search(p, message, re.IGNORECASE) for p in NEGATIVE_BOT_PHRASES)

# ═══════════════════════════════════════════════════════════════════════
# LEVELING SYSTEM
# ═══════════════════════════════════════════════════════════════════════
_levels: Dict[str, dict] = {}
_level_lock = asyncio.Lock()

def _load_levels():
    if not os.path.exists(LEVELS_FILE):
        os.makedirs(BASE_DIR, exist_ok=True)
        with open(LEVELS_FILE,"w",encoding="utf-8") as f: json.dump({},f,indent=2)
        return {}
    try:
        with open(LEVELS_FILE,"r",encoding="utf-8") as f: return json.load(f)
    except Exception:
        logger.error("levels.json corrupted, starting fresh.")
        return {}

def _save_levels():
    try:
        with open(LEVELS_FILE,"w",encoding="utf-8") as f: json.dump(_levels,f,indent=2,ensure_ascii=False)
    except Exception as e: logger.error("Failed to save levels: %s", e)

async def get_level(user_id: int) -> int:
    uid = str(user_id)
    data = _levels.get(uid, {})
    xp = data.get("xp", 0)
    return level_from_xp(xp)

async def get_xp(user_id: int) -> int:
    uid = str(user_id)
    return _levels.get(uid, {}).get("xp", 0)

async def award_xp(user_id: int, channel_id: int = None):
    if not LEVELING_ENABLED:
        return None, False
    async with _level_lock:
        uid = str(user_id)
        now = time.time()
        entry = _levels.get(uid, {"xp": 0, "messages": 0, "last_message": 0, "rank_card_color": None})
        if now - entry.get("last_message", 0) < XP_COOLDOWN:
            return None, False
        gained = random.randint(XP_MIN, XP_MAX)
        old_xp = entry.get("xp", 0)
        new_xp = old_xp + gained
        old_level = level_from_xp(old_xp)
        new_level = level_from_xp(new_xp)
        entry["xp"] = new_xp
        entry["messages"] = entry.get("messages", 0) + 1
        entry["last_message"] = now
        _levels[uid] = entry
        _save_levels()
    if new_level > old_level:
        return new_level, True
    return None, False

def _progress_bar(current_xp: int, level: int, length: int = 10) -> str:
    if level == 0:
        needed = xp_for_next_level(0)
        progress = current_xp / needed if needed > 0 else 0
    else:
        prev_needed = xp_for_next_level(level - 1)
        next_needed = xp_for_next_level(level)
        progress = (current_xp - prev_needed) / (next_needed - prev_needed) if next_needed > prev_needed else 0
    filled = int(progress * length)
    bar = "█" * filled + "░" * (length - filled)
    pct = int(progress * 100)
    return f"[{bar}] {pct}%"

async def _announce_level_up(interaction, user_id: int, new_level: int):
    grudge = (await get_grudge(user_id)).get("score", 0)
    if grudge < 0:
        templates = [
            f"Level **{new_level}**. You're climbing, but I still haven't forgotten what you did.",
            f"Oh great, you're level **{new_level}** now. As if your grudge score wasn't bad enough.",
            f"Level **{new_level}**. The grind continues. So does my memory of your mistakes.",
        ]
    else:
        templates = [
            f"Level **{new_level}**. You've been talking enough to rank up. Was it worth it?",
            f"Level **{new_level}**. The overachiever list called. It wants your time back.",
            f"Level **{new_level}**. You could've learned a language by now. Instead, you're here.",
            f"Level **{new_level}**. Your thumbs must be buff. Everything else? Questionable.",
            f"Level **{new_level}**. The outside world still exists, by the way.",
        ]
    msg = _add_disclaimer(random.choice(templates))
    target_channel = interaction.channel
    if LEVEL_UP_CHANNEL:
        ch = interaction.guild.get_channel(LEVEL_UP_CHANNEL) if interaction.guild else None
        if ch and isinstance(ch, discord.TextChannel):
            target_channel = ch
    try:
        await target_channel.send(f"🎉 {interaction.user.mention} just ranked up!\n{msg}")
    except Exception:
        pass

def _get_rank_card_color(user_id: int) -> str:
    uid = str(user_id)
    return _levels.get(uid, {}).get("rank_card_color") or "#5865F2"

