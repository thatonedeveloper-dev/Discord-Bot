    "{expr} yields {ans}","{expr} produces {ans}","{expr} is {ans}",
]
_SIMPLE_MULTI_JOINERS = [", ","; "," and "," then "," also "," plus "," along with "," together with "]

def _format_multiple_simple(eqs):
    h = random.choice(_SIMPLE_MULTI_HEADERS)
    items = [random.choice(_SIMPLE_MULTI_ITEM_FORMATS).format(expr=e,ans=a) for e,a in eqs]
    return f"{h} {random.choice(_SIMPLE_MULTI_JOINERS).join(items)}"

