            "notes": "Links the owner set up. Probably a Discord server, maybe a donation page. Who knows."
        },
        CMD_SETTINGS_NAME: {
            "description": CMD_SETTINGS_DESC,
            "usage": "",
            "permissions": "None",
            "notes": "Toggles whether the bot can slide into your DMs about your grudge score."
        },
        CMD_RANK_NAME: {
            "description": "Check your level and XP (or someone else's).",
            "usage": "[user]",
            "permissions": "None",
            "notes": "Levels are earned by chatting. Yes, the bar moves slowly. That's the point."
        },
        "leaderboard": {
            "description": "Hall of Shame – the worst grudge scores on display.",
            "usage": "",
            "permissions": "None",
            "notes": "Only users who've messed up appear. If the leaderboard is empty, behave."
        },
        "xpleaderboard": {
            "description": "Top 10 most active users by XP.",
            "usage": "[page]",
            "permissions": "None",
            "notes": "The overachiever list. Multitab with /leaderboard to compare shame vs. grind."
        },
        "purge": {
            "description": "Bulk delete messages (optionally filter by user).",
            "usage": "<count> [@user]",
            "permissions": "Manage Messages",
            "notes": "Max 100. Messages older than 14 days can't be deleted – Discord's rule, not mine."
        },
        "say": {
            "description": "Make the bot repeat your words like a trained parrot.",
            "usage": "<#channel> <message>",
            "permissions": "Manage Messages",
            "notes": "The message is filtered for blocked words. Nice try."
        },
        "announce": {
            "description": "Send a formatted announcement embed because plain text is beneath you.",
            "usage": "<title> <message>",
            "permissions": "Manage Messages",
            "notes": "Both title and body go through the content filter. Keep it clean."
        },
        "lock": {
            "description": "Lock the current channel – @everyone loses their voice.",
            "usage": "",
            "permissions": "Manage Channels",
            "notes": "Only affects the channel where you run it. Quiet at last."
        },
        "unlock": {
            "description": "Reverse a /lock. The silence is over.",
            "usage": "",
            "permissions": "Manage Channels",
            "notes": "Use wisely. The chaos will return."
        },
        "slowmode": {
            "description": "Set a speed limit on messages in this channel.",
            "usage": "<seconds>",
            "permissions": "Manage Channels",
            "notes": "Set to 0 to disable. Max 21600 seconds (6 hours). Yes, you can basically mute the channel."
        },
        "nickname": {
            "description": "Rewrite someone's identity.",
            "usage": "<@user> <new name>",
            "permissions": "Manage Nicknames",
            "notes": "Leave name blank to reset. The old nick won't be missed."
        },
        "warn": {
            "description": "Officially note that someone messed up. Grudge points drop.",
            "usage": "<@user> [reason]",
            "permissions": "Moderate Members",
            "notes": "Adds -2 to their grudge. They get a DM if their privacy settings allow it."
        },
        "avatar": {
            "description": "Grab someone's profile picture in full resolution.",
            "usage": "[@user]",
            "permissions": "None",
            "notes": "Works in DMs. Perfect for judging their taste."
        },
        "role": {
            "description": "Give, remove, or recolor a role.",
            "usage": "<give/remove> <@user> <@role>  OR  color <@role> <#hex>",
            "permissions": "Manage Roles",
            "notes": "The 'color' action only needs the role and hex. No user required."
        },
        "serverinfo": {
            "description": "Show off this server's vital stats.",
            "usage": "",
            "permissions": "None",
            "notes": "Members, boosts, creation date – all the numbers that don't really matter."
        },
        "roleinfo": {
            "description": "Inspect a role: colour, position, members, permissions.",
            "usage": "<@role>",
            "permissions": "None",
            "notes": "If a role has no special permissions, the bot will let you know."
        },
        "setup": {
            "description": "The server setup guide you should've read before inviting me.",
            "usage": "",
            "permissions": "None",
            "notes": "Covers invite link, permissions, and where to tweak settings."
        },
    }
    return data.get(command)

@tree.command(name="help", description="Show all available commands or get help on a specific one")
@app_commands.describe(command="Which command to learn about")
@app_commands.choices(command=[
    app_commands.Choice(name=CMD_CHAT_NAME, value=CMD_CHAT_NAME),
    app_commands.Choice(name=CMD_PROFILE_NAME, value=CMD_PROFILE_NAME),
    app_commands.Choice(name=CMD_LYRICS_NAME, value=CMD_LYRICS_NAME),
    app_commands.Choice(name=CMD_BADAPPLE_NAME, value=CMD_BADAPPLE_NAME),
    app_commands.Choice(name=CMD_SUPPORT_NAME, value=CMD_SUPPORT_NAME),
    app_commands.Choice(name=CMD_SETTINGS_NAME, value=CMD_SETTINGS_NAME),
    app_commands.Choice(name=CMD_RANK_NAME, value=CMD_RANK_NAME),
    app_commands.Choice(name="leaderboard", value="leaderboard"),
    app_commands.Choice(name="xpleaderboard", value="xpleaderboard"),
    app_commands.Choice(name="purge", value="purge"),
    app_commands.Choice(name="say", value="say"),
    app_commands.Choice(name="announce", value="announce"),
    app_commands.Choice(name="lock", value="lock"),
    app_commands.Choice(name="unlock", value="unlock"),
    app_commands.Choice(name="slowmode", value="slowmode"),
    app_commands.Choice(name="nickname", value="nickname"),
    app_commands.Choice(name="warn", value="warn"),
    app_commands.Choice(name="avatar", value="avatar"),
    app_commands.Choice(name="role", value="role"),
    app_commands.Choice(name="serverinfo", value="serverinfo"),
    app_commands.Choice(name="roleinfo", value="roleinfo"),
    app_commands.Choice(name="setup", value="setup"),
])
async def help_command(interaction: discord.Interaction, command: str = None):
    if command is None:
        embed = discord.Embed(
            title="📋 Available Commands",
            description="Here's everything I can do for you.\n*italics* = optional argument",
            color=0x5865F2
        )
        embed.add_field(name=f"/{CMD_CHAT_NAME} <message>", value=CMD_CHAT_DESC, inline=False)
        embed.add_field(name=f"/{CMD_PROFILE_NAME} [user]", value=CMD_PROFILE_DESC, inline=False)
        embed.add_field(name=f"/{CMD_LYRICS_NAME} <query>", value=CMD_LYRICS_DESC, inline=False)
        embed.add_field(name=f"/{CMD_BADAPPLE_NAME}", value=CMD_BADAPPLE_DESC, inline=False)
        embed.add_field(name=f"/{CMD_SUPPORT_NAME}", value=CMD_SUPPORT_DESC, inline=False)
        embed.add_field(name=f"/{CMD_SETTINGS_NAME}", value=CMD_SETTINGS_DESC, inline=False)
        embed.add_field(name=f"/{CMD_RANK_NAME} [user]", value="Check your level and XP", inline=False)
        embed.add_field(name="/help [command]", value="Get detailed help on a specific command", inline=False)
        embed.add_field(name="/leaderboard", value="Hall of Shame – grudge scores", inline=False)
        embed.add_field(name="/xpleaderboard", value="XP leaderboard", inline=False)
        embed.add_field(name="/purge <count> [@user]", value="Delete messages", inline=False)
        embed.add_field(name="/say <channel> <message>", value="Make the bot talk", inline=False)
        embed.add_field(name="/announce <title> <message>", value="Send an announcement embed", inline=False)
        embed.add_field(name="/lock / unlock", value="Lock / unlock current channel", inline=False)
        embed.add_field(name="/slowmode <seconds>", value="Set channel slowmode", inline=False)
        embed.add_field(name="/nickname @user <name>", value="Change a member's nickname", inline=False)
        embed.add_field(name="/warn @user [reason]", value="Warn a member (adds grudge)", inline=False)
        embed.add_field(name="/avatar [@user]", value="Show full-size avatar", inline=False)
        embed.add_field(name="/role give/remove/color", value="Manage roles", inline=False)
        embed.add_field(name="/serverinfo", value="Server statistics", inline=False)
        embed.add_field(name="/roleinfo @role", value="Role details", inline=False)
        embed.add_field(name="/setup", value="Server setup guide", inline=False)
        embed.set_footer(text="Console commands available for the owner — check the terminal!")
        await interaction.response.send_message(embed=embed)
        return

    info = _get_command_info(command)
    if info is None:
        await interaction.response.send_message(f"I don't have any info on `{command}`. Maybe you dreamed it.", ephemeral=True)
        return
    embed = discord.Embed(
        title=f"ℹ️ Help: /{command}",
        description=info.get("description", "No description available."),
        color=0x5865F2
    )
    usage = info.get("usage", "")
    if usage:
        embed.add_field(name="Usage", value=f"`/{command} {usage}`", inline=False)
    perms = info.get("permissions", "")
    if perms:
        embed.add_field(name="Required Permissions", value=perms, inline=False)
    notes = info.get("notes", "")
    if notes:
        embed.add_field(name="Notes", value=notes, inline=False)
    await interaction.response.send_message(embed=embed)


