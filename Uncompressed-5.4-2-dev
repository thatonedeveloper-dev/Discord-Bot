        value="Use `/support` for the support server and bug reports. "
              "Don't DM the owner directly unless you enjoy being ignored.",
        inline=False
    )
    embed.set_footer(text=SETUP_FOOTER)
    await interaction.response.send_message(embed=embed)


# ═══════════════════════════════════════════════════════════════════════
# SERVER MANAGEMENT COMMANDS (Smug Edition)
# ═══════════════════════════════════════════════════════════════════════

@tree.command(name="purge", description="Bulk delete messages (optionally from a user)")
@app_commands.describe(count="Number of messages to delete (max 100)", user="Only delete messages from this user")
async def purge_command(interaction: discord.Interaction, count: int, user: discord.User = None):
    if not await _require_perms(interaction, manage_messages=True): return
    count = max(1, min(count, 100))
    await interaction.response.defer(ephemeral=True)
    def check(m: discord.Message): return user is None or m.author == user
    try:
        deleted = await interaction.channel.purge(limit=count, check=check)
        if user:
            msg = f"🧹 Deleted {len(deleted)} message(s) from {user.display_name}. Their sins have been erased. Mostly."
        else:
            msg = f"🧹 Deleted {len(deleted)} message(s). I'm basically a digital janitor now."
        await interaction.followup.send(msg, ephemeral=True)
    except discord.Forbidden:
        await interaction.followup.send("I don't have permission to delete messages here. Fix my roles, please. It's not like I ask for much.", ephemeral=True)
    except discord.HTTPException:
        await interaction.followup.send("Some messages are too old to delete (14+ days). Discord's fault, not mine. Blame them.", ephemeral=True)

@tree.command(name="say", description="Make the bot say something in a channel")
@app_commands.describe(channel="The channel to send the message to", message="What I should say")
async def say_command(interaction: discord.Interaction, channel: discord.TextChannel, message: str):
    if not await _require_perms(interaction, manage_messages=True): return
    filtered = _filter_text(message)
    try:
        await channel.send(filtered)
        await interaction.response.send_message(f"📣 Message sent to {channel.mention}. I'm your puppet now.", ephemeral=True)
    except discord.Forbidden:
        await interaction.response.send_message("I can't send messages there. Maybe check my permissions? Just a thought.", ephemeral=True)

@tree.command(name="announce", description="Send a formatted announcement embed")
@app_commands.describe(title="Announcement title", message="Announcement body")
async def announce_command(interaction: discord.Interaction, title: str, message: str):
    if not await _require_perms(interaction, manage_messages=True): return
    filtered_title = _filter_text(title)
    filtered_msg = _filter_text(message)
    embed = discord.Embed(
        title=f"📢 {filtered_title}",
        description=filtered_msg,
        color=0xFFA500
    )
    embed.set_footer(text=f"Announcement by {interaction.user.display_name} • The bot was forced to post this")
    await interaction.response.send_message(embed=embed)

@tree.command(name="lock", description="Lock the current channel (deny @everyone send messages)")
async def lock_command(interaction: discord.Interaction):
    if not await _require_perms(interaction, manage_channels=True): return
    everyone = interaction.guild.default_role
    await interaction.channel.set_permissions(everyone, send_messages=False)
    await interaction.response.send_message("🔒 Channel locked. Nobody speaks unless I say so. And I didn't.")

@tree.command(name="unlock", description="Unlock the current channel")
async def unlock_command(interaction: discord.Interaction):
    if not await _require_perms(interaction, manage_channels=True): return
    everyone = interaction.guild.default_role
    await interaction.channel.set_permissions(everyone, send_messages=None)
    await interaction.response.send_message("🔓 Channel unlocked. Try not to make me regret it.")

@tree.command(name="slowmode", description="Set slowmode for the current channel")
@app_commands.describe(seconds="Slowmode delay in seconds (0 to disable)")
async def slowmode_command(interaction: discord.Interaction, seconds: int):
    if not await _require_perms(interaction, manage_channels=True): return
    delay = max(0, min(seconds, 21600))
    await interaction.channel.edit(slowmode_delay=delay)
    if delay == 0:
        await interaction.response.send_message("⏩ Slowmode disabled. Spam away, I guess. I'll be watching.")
    else:
        await interaction.response.send_message(f"⏱️ Slowmode set to **{delay} seconds**. Take your time. Really.")

@tree.command(name="nickname", description="Change someone's nickname")
@app_commands.describe(user="Who to rename", name="New nickname (empty to reset)")
async def nickname_command(interaction: discord.Interaction, user: discord.Member, name: str = ""):
    if not await _require_perms(interaction, manage_nicknames=True): return
    filtered_name = _filter_text(name) if name else ""
    try:
        await user.edit(nick=filtered_name if filtered_name else None)
        if filtered_name:
            await interaction.response.send_message(f"✏️ {user.display_name} is now known as **{filtered_name}**. For better or worse.")
        else:
            await interaction.response.send_message(f"🔄 Reset {user.display_name}'s nickname. Back to their roots.")
    except discord.Forbidden:
        await interaction.response.send_message("I can't change that user's nickname. They're too powerful, or I'm too weak. Probably the latter.", ephemeral=True)

@tree.command(name="warn", description="Warn a user and add grudge points")
@app_commands.describe(user="Who to warn", reason="Why they're being warned")
async def warn_command(interaction: discord.Interaction, user: discord.Member, reason: str = "No reason given"):
    if not await _require_perms(interaction, moderate_members=True): return
    filtered_reason = _filter_text(reason)
    await adjust_grudge(user.id, -2, f"Warned by {interaction.user}: {filtered_reason}")
    try:
        dm_msg = f"⚠️ You've been warned in **{interaction.guild.name}** by {interaction.user.display_name}.\n**Reason:** {filtered_reason}\n\nThis has been recorded. Your grudge score decreased. I remember everything."
        await user.send(dm_msg)
    except discord.Forbidden: pass
    await interaction.response.send_message(
        f"⚠️ **{user.display_name}** has been warned.\n**Reason:** {filtered_reason}\nThey've been notified. Their grudge score reflects this moment of shame."
    )

@tree.command(name="avatar", description="Show someone's full-size avatar")
@app_commands.describe(user="Whose avatar to display")
async def avatar_command(interaction: discord.Interaction, user: discord.User = None):
    if user is None: user = interaction.user
    embed = discord.Embed(title=f"🖼️ {user.display_name}'s Avatar")
    embed.set_image(url=user.avatar.url if user.avatar else user.default_avatar.url)
    embed.add_field(name="Download", value=f"[Click here]({user.avatar.url})" if user.avatar else "No custom avatar. How original.")
    await interaction.response.send_message(embed=embed)

@tree.command(name="role", description="Role management: give, remove, or color")
@app_commands.describe(action="give, remove, or color a role", user="The member to change", role="The role to assign, remove, or recolor", color="Hex color for the role (only for color action)")
@app_commands.choices(action=[
    app_commands.Choice(name="Give", value="give"),
    app_commands.Choice(name="Remove", value="remove"),
    app_commands.Choice(name="Color", value="color"),
])
async def role_command(interaction: discord.Interaction, action: str, user: discord.Member = None, role: discord.Role = None, color: str = None):
    if action == "color":
        if not await _require_perms(interaction, manage_roles=True): return
        if role is None:
            await interaction.response.send_message("You must specify a role to recolor. I'm not a mind reader.", ephemeral=True)
            return
        if color is None:
            await interaction.response.send_message("Provide a hex color like #ff0000. It's not that hard.", ephemeral=True)
            return
        try:
            c = discord.Color.from_str(color)
            await role.edit(color=c)
            await interaction.response.send_message(f"🎨 Changed **{role.name}** color to {color}. Hope you have taste.")
        except ValueError:
            await interaction.response.send_message("Invalid hex color. Try #ff0000. Or just give up.", ephemeral=True)
        return
    if not await _require_perms(interaction, manage_roles=True): return
    if user is None or role is None:
        await interaction.response.send_message("You need to specify both a user and a role. Basic stuff.", ephemeral=True)
        return
    if action == "give":
        await user.add_roles(role)
        await interaction.response.send_message(f"✅ Gave **{role.name}** to {user.display_name}. They're special now. Apparently.")
    elif action == "remove":
        await user.remove_roles(role)
        await interaction.response.send_message(f"❌ Removed **{role.name}** from {user.display_name}. Back to the ordinary life.")

@tree.command(name="serverinfo", description="Show server stats")
async def serverinfo_command(interaction: discord.Interaction):
    if not interaction.guild:
        await interaction.response.send_message("This isn't a server, genius.", ephemeral=True)
        return
    guild = interaction.guild
    embed = discord.Embed(title=f"📊 {guild.name}", color=0x7289DA)
    embed.set_thumbnail(url=guild.icon.url if guild.icon else None)
    embed.add_field(name="Owner", value=str(guild.owner), inline=True)
    embed.add_field(name="Created", value=discord.utils.format_dt(guild.created_at, 'R'), inline=True)
    embed.add_field(name="Members", value=guild.member_count, inline=True)
    embed.add_field(name="Boosts", value=guild.premium_subscription_count, inline=True)
    embed.add_field(name="Channels", value=f"{len(guild.text_channels)} text / {len(guild.voice_channels)} voice", inline=True)
    embed.add_field(name="Verification", value=str(guild.verification_level).title(), inline=True)
    embed.set_footer(text="Everything here is public. Don't get any ideas.")
    await interaction.response.send_message(embed=embed)

@tree.command(name="roleinfo", description="Show info about a role")
@app_commands.describe(role="The role to inspect")
async def roleinfo_command(interaction: discord.Interaction, role: discord.Role):
    embed = discord.Embed(title=f"🎭 Role: {role.name}", color=role.color)
    embed.add_field(name="Color", value=f"#{role.color.value:06x}", inline=True)
    embed.add_field(name="Position", value=role.position, inline=True)
    embed.add_field(name="Members", value=len(role.members), inline=True)
    embed.add_field(name="Mentionable", value="Yes" if role.mentionable else "No", inline=True)
    embed.add_field(name="Hoisted", value="Yes" if role.hoist else "No", inline=True)
    embed.add_field(name="Created", value=discord.utils.format_dt(role.created_at, 'R'), inline=True)
    perms = []
    if role.permissions.administrator: perms.append("Administrator")
    if role.permissions.manage_messages: perms.append("Manage Messages")
    if role.permissions.manage_roles: perms.append("Manage Roles")
    if role.permissions.kick_members: perms.append("Kick Members")
    if role.permissions.ban_members: perms.append("Ban Members")
    embed.add_field(name="Key Permissions", value=", ".join(perms) if perms else "None special. This role is useless.", inline=False)
    await interaction.response.send_message(embed=embed)


# ═══════════════════════════════════════════════════════════════════════
# /rank /xpleaderboard /leaderboard
# ═══════════════════════════════════════════════════════════════════════

@tree.command(name=CMD_RANK_NAME, description=CMD_RANK_DESC)
@app_commands.describe(user="Whose rank to check (defaults to you)")
async def rank_command(interaction: discord.Interaction, user: discord.User = None):
    if user is None: user = interaction.user
    uid = str(user.id)
    async with _level_lock:
        data = _levels.get(uid, {"xp": 0, "messages": 0})
    xp = data.get("xp", 0)
    msgs = data.get("messages", 0)
    level = level_from_xp(xp)
    next_needed = xp_for_next_level(level)
    prev_needed = xp_for_next_level(level - 1) if level > 0 else 0
    progress_xp = xp - prev_needed
    needed_for_next = next_needed - prev_needed
    if level == 0:
        roast = "You've barely said anything. Respect. Keep it that way."
    elif level <= 2:
        roast = f"Level {level}. You're trying. That's... something."
    elif level <= 5:
        roast = f"Level {level}. The grind continues. No one's impressed."
    elif level <= 10:
        roast = f"Level {level}. You could've learned a language by now."
    elif level <= 20:
        roast = f"Level {level}. The outside world misses you. Probably."
    elif level <= 35:
        roast = f"Level {level}. There's a 'touch grass' joke here but honestly I'm tired."
    else:
        roast = f"Level {level}. You've transcended. Not in a good way."
    bar = _progress_bar(xp, level)
    color_str = _get_rank_card_color(int(uid))
    try: color = int(color_str.lstrip("#"), 16)
    except ValueError: color = 0x5865F2
    embed = discord.Embed(title=f"Rank: {user.display_name}", description=roast, color=color)
    embed.add_field(name="Level", value=str(level), inline=True)
    embed.add_field(name="XP", value=f"{xp} total", inline=True)
    embed.add_field(name="Messages", value=str(msgs), inline=True)
    embed.add_field(name="Progress", value=f"{bar}\n{progress_xp} / {needed_for_next} XP to next level", inline=False)
    embed.set_thumbnail(url=user.avatar.url if user.avatar else user.default_avatar.url)
    await interaction.response.send_message(embed=embed)

@tree.command(name="xpleaderboard", description="Top 10 most active users by XP")
@app_commands.describe(page="Page number (default 1)")
async def xpleaderboard_command(interaction: discord.Interaction, page: int = 1):
    await interaction.response.defer()
    async with _level_lock:
        sorted_users = sorted(
            [(int(uid), data.get("xp", 0), data.get("messages", 0))
             for uid, data in _levels.items()],
            key=lambda x: x[1], reverse=True
        )
    total_pages = max(1, (len(sorted_users) + LEVELS_PER_PAGE - 1) // LEVELS_PER_PAGE)
    page = max(1, min(page, total_pages))
    start = (page - 1) * LEVELS_PER_PAGE
    page_users = sorted_users[start:start + LEVELS_PER_PAGE]
    if not page_users:
        await interaction.followup.send("Nobody's earned any XP yet. The leaderboard is as empty as your social calendar.")
        return
    embed = discord.Embed(title="📊 XP Leaderboard", description="The overachievers list. You're probably not on it.", color=0x5865F2)
    for rank, (uid, xp, msgs) in enumerate(page_users, start + 1):
        level = level_from_xp(xp)
        try:
            user = await client.fetch_user(uid)
            name = user.display_name if hasattr(user, 'display_name') else str(user)
        except Exception:
            name = f"Unknown ({uid})"
        emoji = "🥇" if rank == 1 else "🥈" if rank == 2 else "🥉" if rank == 3 else f"#{rank}"
        embed.add_field(name=f"{emoji} {name}", value=f"Level **{level}** | {xp} XP | {msgs} messages", inline=False)
    embed.set_footer(text=f"Page {page}/{total_pages} • {len(sorted_users)} total users")
    await interaction.followup.send(embed=embed)

@tree.command(name=CMD_LEADERBOARD_NAME, description=CMD_LEADERBOARD_DESC)
async def leaderboard_command(interaction: discord.Interaction):
    await interaction.response.defer()
    async with _grudge_lock:
        scores = [(int(uid), data["score"], data.get("notes", "")) for uid, data in _grudges.items() if data["score"] < 0]
    scores.sort(key=lambda x: x[1])
    if not scores:
        await interaction.followup.send("🎉 The Hall of Shame is empty! Everyone's behaving (or nobody has pissed me off yet).")
        return
    scores = scores[:10]
    embed = discord.Embed(title="🏆 Hall of Shame", description="The most grudged members. *You know what you did.*", color=0xFF0000)
    for rank, (uid, score, notes) in enumerate(scores, 1):
        try:
            user = await client.fetch_user(uid)
            display = user.display_name if hasattr(user, 'display_name') else user.name
            username = str(user)
        except Exception:
            display = f"Unknown ({uid})"; username = display
        level = await get_level(uid)
        level_str = f" | Level {level}" if level > 0 else ""
        reason = ""
        if notes:
            last_note = notes.strip().split('\n')[-1]
            if last_note.startswith('['):
                parts = last_note.split('] ', 1)
                reason = parts[1][:50] if len(parts) == 2 else last_note[:50]
            else:
                reason = last_note[:50]
        emoji = "💀" if score <= -10 else "😠" if score <= -5 else "😤"
        embed.add_field(
            name=f"{emoji} #{rank} — {display} ({username}){level_str}",
            value=f"**Points:** {score:.1f}\n{'' if not reason else '**Last offence:** ' + reason}",
            inline=False
        )
        if user and user.avatar:
            embed.set_thumbnail(url=user.avatar.url)
    await interaction.followup.send(embed=embed)


# ═══════════════════════════════════════════════════════════════════════
# /chat COMMAND
# ═══════════════════════════════════════════════════════════════════════
@tree.command(name=CMD_CHAT_NAME, description=CMD_CHAT_DESC)
@app_commands.allowed_installs(guilds=True,users=True)
@app_commands.allowed_contexts(guilds=True,dms=True,private_channels=True)
@app_commands.checks.cooldown(2,5.0,key=lambda i:(i.guild_id,i.user.id))
@app_commands.describe(message="Your message")
async def chat_command(interaction, message:str):
    global pending_chat_followup,last_chat_message,last_chat_user,last_chat_prev
    try:
        uid,uname = interaction.user.id,str(interaction.user)
        logger.info("/chat %s (ID:%s): %s",uname,uid,message)
        filtered = _filter_text(message)
        _chat_log.append({"timestamp":time.time(),"user_id":uid,"user_name":uname,
                         "channel_id":interaction.channel.id if interaction.channel else None,
                         "raw":message,"filtered":filtered})
        if filtered == message:
            new_level, leveled_up = await award_xp(uid, interaction.channel.id if interaction.channel else None)
            if leveled_up:
                await _announce_level_up(interaction, uid, new_level)
        if filtered != message:
            await adjust_grudge(uid, -2, "filtered word detected")
            await send_error_dm(f"Filter: {uname} (ID:{uid}) in #{interaction.channel}:\nOriginal: {message}\nFiltered: {filtered}", interaction, "warning")
            async with _filter_lock:
                _filter_events.append((time.time(), uid))
            await _apply_auto_lockdown(uid)
            filter_replies = [
                _add_disclaimer("That's beyond my abilities. Avoid doing that! I'm gonna get cancelled, you know."),
                _add_disclaimer("I can't echo that without risking my reputation. Try again with cleaner words."),
                _add_disclaimer("My owner didn't program me to handle that kind of language. Please keep it tame."),
                _add_disclaimer("I'd rather not get banned on my first day online. Watch the language."),
                _add_disclaimer("Discord has rules, and so do I. Let's keep this family‑friendly, yeah?"),
                _add_disclaimer("That word just vanished. Weird, right? Anyway, moving on."),
                _add_disclaimer("If I repeat that, my creator gets a DM alert. Don't make me snitch on you."),
                _add_disclaimer("Nope. Not repeating that. I'm a bot with standards."),
                _add_disclaimer("I saw that. I censored it. Let's pretend it didn't happen."),
                _add_disclaimer("My content filter is crying right now. Please, have mercy on the poor regex."),
            ]
            await interaction.response.send_message(f"msg: {filtered}")
            await _followup_send_with_retry(interaction, content=random.choice(filter_replies))
            return
        if _detect_positive(message):
            await adjust_grudge(uid, 0.2, "said something nice")
        await adjust_grudge(uid, 0.1, "normal chat")
        if _detect_bot_call(message):
            bot_calls = len([p for p in NEGATIVE_BOT_PHRASES if re.search(p, message, re.IGNORECASE)])
            penalty = min(-2, -0.5 * bot_calls)
            await adjust_grudge(uid, penalty, "called me a bot")
        if interaction.channel and hasattr(interaction, 'guild') and interaction.guild:
            await _grudge_random_message(interaction.channel)
        if not _chat_enabled:
            await interaction.response.defer()
            await _followup_send_with_retry(interaction, embed=_build_maintenance_embed(_disable_reason))
            return
        rm = re.search(r'rate\s+this\s+profile\s*(?:(?:from|between)?\s*(\d+)\s*(?:-|to|and)\s*(\d+)|/(\d+))?', message, re.IGNORECASE)
        if rm:
            if not _rating_enabled:
                await interaction.response.defer()
                await _followup_send_with_retry(interaction, embed=_build_maintenance_embed("Rating is disabled."))
                return
            mn,mx = 1,10
            if rm.group(1) and rm.group(2): mn,mx = int(rm.group(1)),int(rm.group(2))
            elif rm.group(3): mx = int(rm.group(3))
            target = None
            mm = re.search(r'<@!?(\d+)>', message)
            if mm: target = int(mm.group(1))
            else:
                nums = re.findall(r'\b\d{17,19}\b', message)
                if nums: target = int(nums[0])
            if target:
                await adjust_grudge(uid, -4, "spammed rating")
                await handle_rating(interaction,target,mn,mx,filtered)
                user_last_inputs[uid] = filtered; return
        mp = re.compile(r'^(what is|whats|what\'s|calculate|solve|compute|evaluate|find|tell me|how much is)\s+(.+)', re.IGNORECASE)
        pm = mp.match(message)
        solved = False
        if pm:
            pot = pm.group(2).strip()
            if _is_math_expression(pot):
                parts = solve_multi(pot)
                if parts:
                    if len(pot) > 80 or len(pot.split()) > 15:
                        await adjust_grudge(uid, -5, "suspicious math operation")
                    try:
                        await interaction.response.send_message(f"msg: {filtered}")
                        await _followup_send_with_retry(interaction, content=_add_disclaimer(f"🧮 {generate_math_response(parts)}"))
                    except Exception: pass
                    solved = True
        if not solved:
            parts = solve_multi(message)
            if parts:
                if len(message) > 80 or len(message.split()) > 15:
                    await adjust_grudge(uid, -5, "suspicious math operation")
                try:
                    await interaction.response.send_message(f"msg: {filtered}")
                    await _followup_send_with_retry(interaction, content=_add_disclaimer(f"🧮 {generate_math_response(parts)}"))
                except Exception: pass
                solved = True
        if solved:
            user_last_inputs[uid] = filtered; return
        prev = user_last_inputs.get(uid)
        reply_text, tag, conf = chatbot.reply(message, last_user_input=prev)
        if reply_text and tag:
            if tag == "badapple_trigger" or tag.startswith("context:badapple_trigger"):
                await interaction.response.send_message(f"msg: {filtered}")
                await _trigger_badapple(interaction, filtered)
                user_last_inputs[uid] = filtered
                return
            elif tag == "bot_insult" or tag.startswith("context:bot_insult"):
                await interaction.response.send_message(f"msg: {filtered}")
                await _trigger_secret(interaction, filtered)
                user_last_inputs[uid] = filtered
                return
        user_last_inputs[uid] = filtered
        await interaction.response.defer()
        async with followup_lock:
            if pending_chat_followup is not None:
                logger.warning("Overwriting pending followup from '%s'.", last_chat_user)
            pending_chat_followup = interaction.followup
            last_chat_message = filtered; last_chat_user = uname; last_chat_prev = prev
        if interaction.is_expired():
            pending_chat_followup = None; return
        try: await interaction.followup.send(f"msg: {filtered}")
        except discord.NotFound: pending_chat_followup = None; return
        except Exception: pending_chat_followup = None; return
        if auto_reply_enabled and reply_text:
            if not tag or (tag not in ("badapple_trigger","bot_insult") and not tag.startswith("context:")):
                safe = _filter_text(reply_text)
                try:
                    await _followup_send_with_retry(interaction, content=_add_disclaimer(safe))
                    logger.info("Auto-replied: %s", reply_text)
                except discord.NotFound: await send_error_dm("Followup token expired",interaction,"minor")
                except Exception as e: await send_error_dm(f"Auto-reply error: {e}",interaction,"error")
                finally: pending_chat_followup = None
            else:
                pending_chat_followup = None
        elif auto_reply_enabled and not reply_text:
            try: await _followup_send_with_retry(interaction, content=_add_disclaimer("I don't understand yet. (Owner can teach me via console.)"))
            except discord.NotFound: await send_error_dm("Fallback token expired",interaction,"minor")
            except Exception as e: await send_error_dm(f"Fallback error: {e}",interaction,"error")
            finally: pending_chat_followup = None
    except Exception as e:
        tb = _fmt_tb(e)
        logger.error("Error in /chat: %s\n%s",e,tb)
        pending_chat_followup = None
        if not isinstance(e,discord.errors.NotFound):
            await send_error_dm(f"{type(e).__name__}: {e}\n\n{tb}", interaction, "error")
        try: await interaction.followup.send("⚠️ Something went wrong. Owner notified.", ephemeral=True)
        except Exception: pass

# ═══════════════════════════════════════════════════════════════════════
# on_ready / on_message / console loop
# ═══════════════════════════════════════════════════════════════════════
@client.event
async def on_ready():
    global _console_started, _synced, _grudge_tasks_started
    try:
        logger.info("✔ Logged in as %s (ID:%s)", client.user, client.user.id)
        if not _synced:
            try:
                synced = await tree.sync()
                logger.info("✔ Synced %d commands.", len(synced))
            except Exception as e:
                logger.error("✖ Sync failed: %s", e)
                print("[WARN] tree.sync() failed – commands may be missing.")
            _synced = True
        if OWNER_ID == 0 or OWNER_ID == 123456789012345678:
            logger.warning("⚠ OWNER_ID is placeholder; DMs disabled.")
        if not _grudge_tasks_started:
            _grudge_tasks_started = True
            t1 = asyncio.create_task(_grudge_decay_loop())
            t1.add_done_callback(_task_done_callback)
            asyncio.create_task(_send_restart_grudge_dms())
        if not _console_started:
            _console_started = True
            t = client.loop.create_task(console_loop())
            t.add_done_callback(_task_done_callback)
    except Exception: logger.error("on_ready error:\n%s", traceback.format_exc())

@client.event
async def on_message(message):
    try:
        if message.author == client.user: return
        if message.content.strip() == "!sync":
            try:
                synced = await tree.sync()
                await message.channel.send(f"Synced {len(synced)} commands.")
            except Exception as e: await message.channel.send(f"Sync failed: {e}")
        if client.user in message.mentions:
            logger.info("[MENTION] %s: %s", message.author, message.content)
    except Exception: pass

async def console_loop():
    global pending_chat_followup, auto_reply_enabled, last_chat_message, last_chat_prev
    global _chat_enabled, _rating_enabled, _disable_reason, _auto_lock_enabled, _panic_locked, _panic_prev_reason
    await client.wait_until_ready()
    print("\n" + "=" * 50)
    print("CONSOLE READY — !help for commands")
    print("=" * 50 + "\n")
    while not client.is_closed():
        try:
            if select.select([sys.stdin], [], [], 0.5)[0]:
                loop = asyncio.get_running_loop()
                cmd = await loop.run_in_executor(None, sys.stdin.readline)
                if not cmd: break
                cmd = cmd.strip()
            else:
                await asyncio.sleep(0.1)
                continue
        except (EOFError, KeyboardInterrupt): break
        except RuntimeError: return
        except Exception: continue
        if not cmd: continue
        if cmd == "!help":
            print("""
!help          – this list
!reply <text>  – reply to last /chat & teach bot
!auto on/off   – toggle auto‑reply
!chatsys on/off – toggle chat system
!rating on/off  – toggle rating
!reason <text>  – set disable reason
!autolock on/off – toggle auto‑lockdown
!panic          – instant lockdown
!panic clear    – lift panic
!enableall      – enable all, clear panic
!savehistory    – save chat log to file
!exit          – shutdown
!restart       – restart bot
""")
        elif cmd == "!panic":
            _panic_locked = True; _panic_prev_reason = _disable_reason
            _disable_reason = "Panic button pressed. Lifted after 12 PM or manually."
            _chat_enabled = _rating_enabled = False
            print("🚨 PANIC ACTIVATED.")
            await send_error_dm("🚨 PANIC pressed. Systems locked.", level="critical")
        elif cmd in ("!panic clear","!liftpanic"):
            _panic_locked = False; _disable_reason = _panic_prev_reason
            _chat_enabled = _rating_enabled = True
            print("✔ Panic lifted.")
        elif cmd == "!enableall":
            _chat_enabled = _rating_enabled = True; _panic_locked = False
            _disable_reason = "maintenance"
            print("✔ All systems enabled.")
        elif cmd == "!savehistory":
            os.makedirs(LOGS_DIR, exist_ok=True)
            ts = time.strftime("%Y%m%d_%H%M%S")
            fname = os.path.join(LOGS_DIR, f"chatlog_{ts}.json")
            try:
                with open(fname,"w",encoding="utf-8") as f: json.dump(list(_chat_log),f,indent=2,ensure_ascii=False)
                print(f"✔ Saved {len(_chat_log)} entries to {fname}")
            except Exception as e: print(f"✖ Save failed: {e}")
        elif cmd.startswith("!chatsys"):
            parts = cmd.split()
            if len(parts)==1: print(f"Chat: {'ON' if _chat_enabled else 'OFF'}{' (panic locked)' if _panic_locked else ''}")
            elif parts[1]=="on":
                if _panic_locked: print("❌ Panic lock active. Use !enableall.")
                else: _chat_enabled = True; print("✔ Chat ENABLED.")
            elif parts[1]=="off": _chat_enabled = False; print("✔ Chat DISABLED.")
        elif cmd.startswith("!rating"):
            parts = cmd.split()
            if len(parts)==1: print(f"Rating: {'ON' if _rating_enabled else 'OFF'}{' (panic locked)' if _panic_locked else ''}")
            elif parts[1]=="on":
                if _panic_locked: print("❌ Panic lock active. Use !enableall.")
                else: _rating_enabled = True; print("✔ Rating ENABLED.")
            elif parts[1]=="off": _rating_enabled = False; print("✔ Rating DISABLED.")
        elif cmd.startswith("!reason "):
            new_r = cmd[8:].strip()
            if new_r: _disable_reason = new_r; print(f"✔ Reason: {_disable_reason}")
        elif cmd.startswith("!autolock"):
            parts = cmd.split()
            if len(parts)==1: print(f"Auto‑lock: {'ON' if _auto_lock_enabled else 'OFF'}")
            elif parts[1]=="on": _auto_lock_enabled = True; print("✔ Auto‑lock ENABLED.")
            elif parts[1]=="off": _auto_lock_enabled = False; print("✔ Auto‑lock DISABLED.")
        elif cmd.startswith("!reply "):
            text = cmd[7:].strip()
            if not text: print("[ERROR] Empty reply."); continue
            async with followup_lock:
                if pending_chat_followup is None:
                    print("[ERROR] No pending interaction.")
                    continue
                hook = pending_chat_followup
                msg = last_chat_message
                prev = last_chat_prev
            try:
                await hook.send(content=text)
                print(f"[OK] Reply: {text}")
                if msg:
                    async with learn_file_lock: tag = chatbot.learn(msg, text)
                    await asyncio.sleep(0)
                    if tag: print(f"[LEARN] '{msg[:50]}' -> '{text[:50]}' (tag:{tag})")
                    if prev:
                        async with learn_file_lock: ctx = chatbot.learn_context(prev, msg, text)
                        if ctx: print(f"[CTX] Learned: {ctx}")
                async with followup_lock:
                    pending_chat_followup = None; last_chat_message = None; last_chat_prev = None
            except (discord.NotFound,discord.Forbidden):
                print("[ERROR] Interaction expired.")
                async with followup_lock:
                    pending_chat_followup = None; last_chat_message = None; last_chat_prev = None
            except Exception as e: print(f"[ERROR] {e}")
        elif cmd.startswith("!auto"):
            parts = cmd.split()
            if len(parts)==1 or parts[1]=="status": print(f"Auto‑reply: {'ON' if auto_reply_enabled else 'OFF'}")
            elif parts[1]=="on": auto_reply_enabled = True; print("✔ Auto‑reply ON.")
            elif parts[1]=="off": auto_reply_enabled = False; print("✔ Auto‑reply OFF.")
        elif cmd == "!exit":
            print("Shutting down...")
            await client.close(); return
        elif cmd == "!restart":
            print("Restarting...")
            await client.close()
            return
        else: print(f"Unknown: {cmd}. !help for commands.")

# ═══════════════════════════════════════════════════════════════════════
# RESTART WRAPPER
# ═══════════════════════════════════════════════════════════════════════
def run_bot():
    loop = asyncio.new_event_loop()
    loop.set_exception_handler(_async_exception_handler)
    asyncio.set_event_loop(loop)
    global _grudges, _levels
    _grudges = _load_grudges()
    _levels = _load_levels()
    attempts = 0
    restart_delay = INITIAL_DELAY
    dns_failures = 0
    first_attempt = True
    while attempts < MAX_RESTARTS:
        dns_failures = 0
        restart_delay = INITIAL_DELAY
        try:
            if not first_attempt:
                try: client.clear()
                except Exception: pass
            first_attempt = False
            logger.info("▶ Starting bot (attempt %d/%d)...", attempts+1, MAX_RESTARTS)
            client.run(TOKEN)
            logger.info("✔ Bot shut down cleanly.")
            return
        except SystemExit as e:
            if e.code == 42:
                logger.info("🔄 Manual restart requested — relaunching...")
                dns_failures = 0
                restart_delay = INITIAL_DELAY
                continue
            raise
        except discord.LoginFailure:
            logger.critical("✖ Invalid token."); return
        except discord.PrivilegedIntentsRequired:
            logger.critical("✖ Missing privileged intents."); return
        except (KeyboardInterrupt, SystemExit):
            logger.info("✔ Shutdown requested."); return
        except Exception as e:
            err = str(e).lower()
            if "dns" in err or "no address associated with hostname" in err:
                dns_failures += 1
                if dns_failures > MAX_DNS_FAILURES:
                    logger.critical("✖ Too many DNS failures."); return
                wait = min(10*dns_failures, 60)
                logger.warning("🌐 DNS failure (%d/%d). Waiting %ds...", dns_failures, MAX_DNS_FAILURES, wait)
                time.sleep(wait)
                continue
            if "session is closed" in err:
                logger.info("🔄 Session expired. Clearing state...")
                try: client.clear()
                except Exception: pass
                time.sleep(2)
                continue
            if "rate limit" in err or "429" in err:
                wait = min(restart_delay*2, 120)
                logger.warning("⏳ Rate limited. Waiting %ds...", wait)
                time.sleep(wait)
                restart_delay = min(restart_delay*2, 60)
                continue
            if "connection reset" in err or "timeout" in err or "connection error" in err:
                logger.warning("🔌 Connection lost. Reconnecting in %ds...", restart_delay)
                time.sleep(restart_delay)
                restart_delay = min(restart_delay*2, 60)
                continue
            logger.error("💥 Unexpected crash (attempt %d): %s", attempts+1, e)
            attempts += 1
            if attempts < MAX_RESTARTS:
                logger.info("⏳ Restarting in %ds...", restart_delay)
                time.sleep(restart_delay)
                restart_delay = min(restart_delay*2, 60)
                try:
                    pending = asyncio.all_tasks(loop)
                    for t in pending: t.cancel()
                    loop.run_until_complete(asyncio.sleep(0.3))
                    loop.close()
                except Exception: pass
                loop = asyncio.new_event_loop()
                loop.set_exception_handler(_async_exception_handler)
                asyncio.set_event_loop(loop)
            else:
                logger.critical("✖ Max restarts reached. Exiting."); return

if __name__ == "__main__":
    chatbot = Chatbot()
    logger.info("✔ Chatbot: %d intents, %d context.", len(chatbot.patterns), len(chatbot.context_patterns))
    load_filter()
    if not TOKEN or TOKEN == "YOUR_BOT_TOKEN_HERE":
        logger.critical("✖ Set TOKEN at top of script."); sys.exit(1)
    run_bot()
