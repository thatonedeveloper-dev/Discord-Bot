# DISCORD BOT SETUP
# ═══════════════════════════════════════════════════════════════════════
intents = discord.Intents.default(); intents.message_content = True
client = discord.Client(intents=intents)
tree = app_commands.CommandTree(client)

pending_chat_followup=None; last_chat_message=None; last_chat_user=None; last_chat_prev=None
user_last_inputs: Dict[int,str] = {}
auto_reply_enabled=True; _console_started=False; _synced=False
followup_lock=asyncio.Lock(); learn_file_lock=asyncio.Lock()

def _fmt_tb(exc): return "".join(traceback.format_exception(type(exc), exc, exc.__traceback__))

async def send_error_dm(msg, interaction=None, level="critical"):
    if not OWNER_ID or OWNER_ID==123456789012345678: return
    try:
        try: await asyncio.wait_for(client.wait_until_ready(), timeout=10.0)
        except (asyncio.TimeoutError, RuntimeError): return
        owner = await client.fetch_user(OWNER_ID)
        if not owner: return
        sev = SEVERITY.get(level, SEVERITY["critical"])
        trunc = msg[:3900] + ("..." if len(msg)>3900 else "")
        embed = discord.Embed(title=sev["title"], color=sev["color"], description=f"**Details:**\n```{trunc}```")
        embed.timestamp = discord.utils.utcnow()
        if interaction:
            ui = f"{interaction.user} (ID:{interaction.user.id})" if interaction.user else "?"
            ci = f"#{interaction.channel}" if interaction.channel else "?"
            embed.add_field(name="Trigger", value=f"**User:** {ui}\n**Channel:** {ci}", inline=False)
        await owner.send(embed=embed)
    except Exception: pass

@tree.error
async def on_tree_error(interaction,error):
    if isinstance(error, app_commands.CommandOnCooldown):
        try:
            if interaction.response.is_done(): await interaction.followup.send(str(error),ephemeral=True)
            else: await interaction.response.send_message(str(error),ephemeral=True)
        except Exception: pass
        return
    if isinstance(error, app_commands.CheckFailure):
        try:
            if interaction.response.is_done(): await interaction.followup.send(str(error),ephemeral=True)
            else: await interaction.response.send_message(str(error),ephemeral=True)
        except Exception: pass
        return
    orig = error
    if isinstance(error, app_commands.CommandInvokeError): orig = getattr(error,"original",None) or error.__cause__ or error
    if isinstance(orig, discord.errors.NotFound):
        try:
            if interaction.response.is_done(): await interaction.followup.send("⚠️ Interaction expired.",ephemeral=True)
            else: await interaction.response.send_message("⚠️ Interaction expired.",ephemeral=True)
        except Exception: pass
        await send_error_dm(f"NotFound: {orig}", interaction, "minor")
        return
    tb = _fmt_tb(orig)
    logger.error("Command error: %s\n%s", orig, tb)
    try:
        if interaction.response.is_done(): await interaction.followup.send("❌ Error. Owner notified.",ephemeral=True)
        else: await interaction.response.send_message("❌ Error. Owner notified.",ephemeral=True)
    except Exception: pass
    await send_error_dm(f"{type(orig).__name__}: {orig}\n\n{tb}", interaction, "critical")

@client.event
async def on_error(event,*args,**kwargs):
    tb = traceback.format_exc()
    error_line = tb.strip().split('\n')[-1] if tb else "Unknown"
    logger.error("⚠ Event error [%s]: %s", event, error_line)
    await send_error_dm(f"Event '{event}':\n\n{tb}", level="warning")

@client.event
async def on_disconnect(): logger.warning("🔌 Disconnected – auto‑reconnect.")

def _task_done_callback(task):
    exc = task.exception()
    if exc is not None: logger.error("Task %s failed: %s", task.get_name(), exc)

def _async_exception_handler(loop, context):
    msg = context.get("message","?")
    exc = context.get("exception")
    tb = _fmt_tb(exc) if exc else str(context)
    logger.error("Asyncio task exception: %s\n%s", msg, tb)
    t = asyncio.create_task(send_error_dm(f"Asyncio: {msg}\n\n{tb}", level="critical"))
    t.add_done_callback(_task_done_callback)

def _build_maintenance_embed(reason):
    gif = random.choice(MAINTENANCE_CAT_GIFS)
    desc = _add_disclaimer(f"Reason: **{reason}**\nPlease try again later.")
    embed = discord.Embed(title="⚠️ This command is temporarily disabled",
                         description=desc, color=0xFFA500)
    embed.set_image(url=gif); embed.timestamp = discord.utils.utcnow()
    return embed

async def _followup_send_with_retry(interaction, content=None, embed=None, retries=1):
    for attempt in range(retries + 1):
        try:
            if embed:
                return await interaction.followup.send(embed=embed)
            else:
                return await interaction.followup.send(content=content)
        except discord.NotFound:
            raise
        except discord.HTTPException as e:
            if e.status >= 500 and attempt < retries:
                await asyncio.sleep(1)
                continue
            raise
        except Exception:
            raise

# ═══════════════════════════════════════════════════════════════════════
# PERMISSION CHECK HELPER
# ═══════════════════════════════════════════════════════════════════════
async def _require_perms(interaction: discord.Interaction, **perms) -> bool:
    if not interaction.guild:
        await interaction.response.send_message(
            "This command only works in servers, not in DMs. Nice try.",
            ephemeral=True
        )
        return False
    member = interaction.guild.get_member(interaction.user.id)
    if member is None:
        await interaction.response.send_message(
            "I can't find you in this server. That's… concerning.",
            ephemeral=True
        )
        return False
    missing = []
    for perm, required in perms.items():
        if not getattr(member.guild_permissions, perm, False):
            missing.append(perm.replace('_', ' ').title())
    if missing:
        await interaction.response.send_message(
            f"You need **{', '.join(missing)}** permission for that. "
            "Come back when you've been promoted, yeah?",
            ephemeral=True
        )
        return False
    return True

