    "{expr} evaluates to {ans}","{expr} results in {ans}","computing {expr} yields {ans}",
    "{expr} -> {ans}","for {expr}, the answer is {ans}","{expr} equals {ans} after evaluation",
    "working on {expr} leads to {ans}",
]
_COMPLEX_MULTI_JOINERS = [", ","; "," and "," then "," also "," plus "," along with ",
                          " together with "," further, "," moreover, "," additionally, "]

def _format_multiple_complex(eqs):
    h = random.choice(_COMPLEX_MULTI_HEADERS)
    items = [random.choice(_COMPLEX_MULTI_ITEM_FORMATS).format(expr=e,ans=a) for e,a in eqs]
    return f"{h} {random.choice(_COMPLEX_MULTI_JOINERS).join(items)}"

_MIXED_MULTI_HEADERS = [
    "Here are the answers to your mixed set:","Some were simple, some needed more work — here's everything:",
    "Let's go through the batch:","Mixed bag results:","Simple and complex solved:",
    "I worked out the whole list:","Your mixed equations resolved:","A blend of easy and advanced:",
    "Here are all the solutions:","All equations done:","Both straightforward and tricky ones:",
    "I solved the simple and the advanced ones:","Here's the set, solved:","Your math batch completed:",
